{
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 2-5 * * *"
    ]
  },
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "schedule": [
        "after 11pm on Monday",
        "after 11pm on Thursday"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "replace"
    }
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:enableMajor"
  ]
}
