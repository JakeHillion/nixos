{
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 2-5 * * *"
    ]
  },
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "schedule": [
        "after 11pm on Monday",
        "after 11pm on Thursday"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "pkgs/caddy-dns-jakehillion/go.mod"
      ],
      "automerge": true,
      "postUpdateOptions": [
        "gomodTidy"
      ],
      "postUpgradeTasks": {
        "commands": [
          "renovate-update-vendor-hash go pkgs/caddy-dns-jakehillion"
        ],
        "fileFilters": [
          "pkgs/vendor-hashes.json"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:enableMajor"
  ]
}
