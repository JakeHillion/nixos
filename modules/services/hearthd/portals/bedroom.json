{
  "version": 1,
  "settings": {
    "hearthd": {
      "enabled": true,
      "base_url": "https://hearthd.iot.home.jakehillion.me"
    },
    "snapcast": {
      "enabled": true,
      "host": "stinger.iot.home.jakehillion.me",
      "volume_sync": true,
      "port": 1704
    },
    "wake_word": {
      "enabled": true,
      "model": "hey_mycroft"
    },
    "voice": {
      "enabled": true,
      "base_url": "https://homeassistant.iot.home.jakehillion.me",
      "pipeline_id": ""
    }
  },
  "root": {
    "type": "photo_screensaver",
    "mode": "solar",
    "timezone": "Europe/London",
    "weather": { "$": "weather" },
    "sun": { "$": "sun" },
    "dwell_seconds": 15,
    "rollover_hour": 4,
    "photos": [
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/landscape/canyonlands/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/landscape/catalina-little-harbor/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/landscape/glacier/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/landscape/joshua-tree/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/landscape/oxenhope/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/landscape/yosemite-lukens/metadata.json"
    ],
    "child": {
      "type": "carousel",
      "pages": [
        {
          "title": "Welcome",
          "child": {
            "type": "grid",
            "children": [
              {
                "type": "light_group",
                "title": "Lights",
                "source": { "$": "lights" },
                "on_targets": [
                  "bedroom_lamp"
                ],
                "lights": [
                  {
                    "entity_id": "bedroom_light",
                    "name": "Light",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "cubby_light",
                    "name": "Cubby",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "bedroom_lamp",
                    "name": "Lamp",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "bedroom_hue_bloom",
                    "name": "Hue",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  }
                ]
              },
              {
                "type": "grid",
                "columns": 2,
                "children": [
                  { "type": "environment", "name": "Bedroom", "temperature": { "$": "environment.bedroom.temperature" }, "humidity": { "$": "environment.bedroom.humidity" } },
                  { "type": "environment", "name": "Bathroom", "temperature": { "$": "environment.bathroom.temperature" }, "humidity": { "$": "environment.bathroom.humidity" } },
                  { "type": "environment", "name": "Living Room", "temperature": { "$": "environment.living_room.temperature" }, "humidity": { "$": "environment.living_room.humidity" } },
                  { "type": "environment", "name": "Loft", "temperature": { "$": "environment.loft.temperature" }, "humidity": { "$": "environment.loft.humidity" } }
                ]
              },
              { "type": "now_playing" },
              {
                "type": "weather",
                "source": { "$": "weather" }
              },
              {
                "type": "clock",
                "show_seconds": false,
                "timezone": "Europe/London"
              }
            ]
          }
        }
      ]
    }
  }
}
