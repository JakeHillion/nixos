{
  "version": 1,
  "settings": {
    "hearthd": {
      "enabled": true,
      "base_url": "https://hearthd.iot.home.jakehillion.me"
    },
    "snapcast": {
      "enabled": true,
      "host": "stinger.iot.home.jakehillion.me",
      "volume_sync": true,
      "port": 1704
    },
    "wake_word": {
      "enabled": true,
      "model": "hey_mycroft"
    },
    "voice": {
      "enabled": true,
      "base_url": "https://homeassistant.iot.home.jakehillion.me",
      "pipeline_id": ""
    }
  },
  "root": {
    "type": "photo_screensaver",
    "mode": "solar",
    "timezone": "Europe/London",
    "weather": { "$": "weather" },
    "sun": { "$": "sun" },
    "dwell_seconds": 15,
    "rollover_hour": 4,
    "photos": [
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/portrait/canyonlands/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/portrait/catalina-little-harbor/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/portrait/glacier/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/portrait/joshua-tree/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/portrait/oxenhope/metadata.json",
      "https://hearthd.iot.home.jakehillion.me/static/screensavers/portrait/yosemite-lukens/metadata.json"
    ],
    "child": {
      "type": "carousel",
      "pages": [
        {
          "title": "Desk",
          "child": {
            "type": "grid",
            "children": [
              {
                "type": "light_group",
                "title": "Lights",
                "source": { "$": "lights" },
                "on_targets": [
                  "living_room_light",
                  "living_room_lamp",
                  "living_room_hue_lamp"
                ],
                "lights": [
                  {
                    "entity_id": "living_room_light",
                    "name": "Light",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "living_room_lamp",
                    "name": "Lamp",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "living_room_hue_lamp",
                    "name": "Hue",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "living_room_desk_lights",
                    "name": "Desk Lights",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  },
                  {
                    "entity_id": "kitchen_light",
                    "name": "Kitchen",
                    "endpoint": 1,
                    "dimmable": true,
                    "color": false
                  }
                ]
              },
              {
                "type": "clock",
                "show_seconds": false,
                "timezone": "Europe/London"
              }
            ]
          }
        }
      ]
    }
  }
}
